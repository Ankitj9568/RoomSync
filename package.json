{
  "name": "roomsync",
  "version": "1.0.0",
  "description": "> **A shared living management platform for roommates, hostel students, PG residents, and shared apartments.**",
  "main": "server.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "jest",
    "test:e2e": "playwright test",
    "postinstall": "prisma generate",
    "vercel-build": "prisma generate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:mysql-to-postgres": "node scripts/migrate-mysql-to-postgres.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "jest": {
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/tests/e2e/"
    ]
  },
  "dependencies": {
    "@prisma/client": "^6.12.0",
    "bcryptjs": "^3.0.3",
    "cookie-session": "^2.1.1",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "mysql2": "^3.23.1",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "jest": "^30.4.2",
    "nodemon": "^3.1.14",
    "prisma": "^6.12.0",
    "supertest": "^7.2.2"
  }
}
